# Atlas connection string (Database > Connect > Drivers > Python)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fleet_geo

# Fleet + simulation
FLEET_SIZE=1500          # trucks to seed. On M0 / Flex use 300 (ops/sec limits)
VESSELS=75               # vessels in the same collection (0 = trucks only)
VESSEL_TIME_SCALE=10     # ships move 10x real speed
AIS_GAP_SECONDS=20       # silent this long while under way = 'dark'
CPA_METERS=400           # close-quarters alert distance
TICK_SECONDS=2           # how often trucks move
TIME_SCALE=4             # 4 = trucks drive 4x real speed so movement is visible
TELEMETRY_EVERY=5        # write a time-series point every N ticks (5 x 2s = every 10s)
TELEMETRY_TTL_HOURS=3    # telemetry auto-expires
BAN_ALWAYS_ON=true       # enforce the downtown truck ban at any hour (demo mode)

HOST=127.0.0.1
PORT=8000
